# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key (Project Settings -> API -> service_role secret).
# Server-side only -- bypasses RLS. Never expose to a browser/client.
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key for the free-tier LLM fallback (console.groq.com)
GROQ_API_KEY=

# Optional: OpenRouter API key (openrouter.ai) used for BYOK generation when set.
# Can be saved from the Settings page instead; this env var is only a deploy default.
OPENROUTER_API_KEY=

# Optional: Google AI Studio Gemini API key (aistudio.google.com — free, no card).
# When set (env or Settings), Gemini takes precedence over OpenRouter for both
# generation and screenshot questions, so the free tier is used.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.6-flash)
# GEMINI_MODEL=

# Optional: override the Gemini vision model for screenshot questions
# (defaults to gemini-3.6-flash)
# GEMINI_VISION_MODEL=

# Optional: override the OpenRouter model (defaults to google/gemini-2.5-flash)
# OPENROUTER_MODEL=

# Optional: override the OpenRouter vision model used for screenshot questions
# (defaults to google/gemini-2.5-flash). Requires an OpenRouter key (BYOK).
# OPENROUTER_VISION_MODEL=
